{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(cd:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(cat:*)",
      "Bash(sort:*)",
      "Bash(tr:*)",
      "Bash(basename:*)",
      "Bash(printf:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(tee:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(tree:*)",
      "Bash(file:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(git:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "jq '.model.display_name |= gsub(\" \\\\([0-9]+[KMkm] context\\\\)\"; \"\")' | npx -y @owloops/claude-powerline@latest --style=powerline"
  },
  "effortLevel": "high",
  "theme": "dark",
  "editorMode": "vim",
  "vim": "true"
}
